# ===========================================================================
# Git Ignore Configuration - Intelligent Cloud Storage Tier Predictor
# ===========================================================================

# Environment Variables & Secrets (NEVER commit secrets or real API keys)
.env
.env.*
.env.local
.env.*.local
!.env.example

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Frontend Build & Dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logging & Diagnostic Output
*.log
logs/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Code Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Raw Datasets (Exclude large raw trace CSVs/dumps, but track documentation)
data/raw/*.csv
data/raw/*.json
data/raw/*.parquet
!data/raw/README.md

# Temporary and Scratch Scripts
scratch/
scratch_*.py
scratch_*.txt
